{
  "name": "@cinatra-ai/slide-deck-artifact",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Slide Deck",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/slide-deck-matcher-skill",
        "kind": "skill",
        "role": "matcher",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required"
      }
    ],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "application/pdf"
          ]
        }
      },
      "ui": {
        "abiVersion": 1,
        "sdkAbiRange": "^2.5.0",
        "renderers": {
          "detail": {
            "entry": "./src/renderers/detail.tsx",
            "propsApiVersion": 2,
            "representations": [
              "application/pdf"
            ]
          }
        }
      },
      "skills": {
        "matchers": [
          "@cinatra-ai/slide-deck-matcher-skill:slide-deck-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7,
      "objectTypes": [
        {
          "type": "@cinatra-ai/slide-deck-artifact:deck",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": true,
            "snapshotPolicy": "content",
            "sensitivity": "normal"
          },
          "schema": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "slideCount": { "type": "number" },
              "runId": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/renderers/detail": {
      "import": "./src/renderers/detail.tsx",
      "default": "./src/renderers/detail.tsx"
    },
    "./src/renderer-props": {
      "types": "./src/renderer-props.ts",
      "import": "./src/renderer-props.ts",
      "default": "./src/renderer-props.ts"
    }
  }
}
